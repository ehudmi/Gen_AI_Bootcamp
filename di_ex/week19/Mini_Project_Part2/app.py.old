import streamlit as st
import asyncio
import nest_asyncio
from client import LeanMCPAgent  # Reuse your existing client class

nest_asyncio.apply()

st.title("📓 My Custom Notes Agent")


@st.cache_resource
def get_agent():
    agent = LeanMCPAgent()
    # Direct connection to ONLY your local server
    asyncio.run(agent.connect("server.py"))
    return agent


agent = get_agent()

if prompt := st.chat_input("Write a note about..."):
    with st.chat_message("user"):
        st.write(prompt)

    with st.chat_message("assistant"):
        response = asyncio.run(agent.chat(prompt))
        st.markdown(response)
